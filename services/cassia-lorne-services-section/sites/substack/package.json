{
  "name": "@red-cup-engineering/substack",
  "version": "0.0.2",
  "type": "module",
  "description": "Cassia Lorne's Routine Read — a syndication-only divination publication: a two-stage daily diviner cycle (atomic divinations, then synthesis under gates) into a reviewable content store.",
  "exports": {
    ".": "./src/indicators.mjs",
    "./gates": "./src/gates.mjs",
    "./read": "./src/read.mjs",
    "./hive-draft": "./src/hive-draft.mjs",
    "./frontmatter": "./src/frontmatter.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "divine:indicators": "node src/indicators.mjs",
    "divine:read": "node src/read.mjs",
    "divine:hive-draft": "node src/hive-draft.mjs",
    "divine": "npm run divine:indicators && npm run divine:read && npm run divine:hive-draft",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/create-hive-post-draft-service": "workspace:*",
    "@lenticule-science/astronomy-position-computation-service": "workspace:*",
    "@lenticule-science/divining": "workspace:*",
    "@red-cup-engineering/json-services-section": "workspace:*"
  },
  "sideEffects": false
}
